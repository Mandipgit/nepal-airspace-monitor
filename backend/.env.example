# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenSky Network Credentials (OAuth2 Client or Basic Auth)
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password
OPENSKY_CLIENT_ID=your_opensky_client_id
OPENSKY_CLIENT_SECRET=your_opensky_client_secret
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_CACHE_TTL_SECONDS=10

# Regional Airspace Bounding Box Defaults (Nepal FIR & Surrounding Corridors)
NEPAL_BOUNDING_BOX_LAMIN=25.80
NEPAL_BOUNDING_BOX_LOMIN=79.80
NEPAL_BOUNDING_BOX_LAMAX=30.65
NEPAL_BOUNDING_BOX_LOMAX=88.50

# FlightAware AeroAPI (Keep empty until configured)
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi
FLIGHTAWARE_CACHE_TTL_SECONDS=5

# Supabase (PostgreSQL) Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Authentication & JWT Configuration
JWT_SECRET=generate_a_secure_random_32_byte_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ADS-B DB Aircraft Metadata API
ADSBDB_AIRCRAFT_API_URL=https://api.adsbdb.com/v0/aircraft

