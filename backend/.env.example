# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# OpenSky Network Credentials (Optional for anonymous, recommended for higher rate limits)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Future Provider: FlightAware AeroAPI (Keep empty until Phase 9)
FLIGHTAWARE_API_KEY=

# Supabase (PostgreSQL) Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Caching and Polling
OPENSKY_CACHE_TTL_SECONDS=10
NEPAL_BOUNDING_BOX_LAMIN=26.34
NEPAL_BOUNDING_BOX_LOMIN=80.05
NEPAL_BOUNDING_BOX_LAMAX=30.45
NEPAL_BOUNDING_BOX_LOMAX=88.20
