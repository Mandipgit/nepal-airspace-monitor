# Backend API URL (Points to FastAPI, never directly to external providers)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Frontend Polling Interval (in milliseconds, configured: 2000ms = 2s)
NEXT_PUBLIC_FLIGHT_POLL_INTERVAL_MS=2000

# Map Settings
NEXT_PUBLIC_MAP_DEFAULT_LAT=28.3949
NEXT_PUBLIC_MAP_DEFAULT_LON=84.1240
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=7

# Supabase (PostgreSQL & GoTrue Auth) Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

